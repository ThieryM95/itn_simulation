            <option name="expectedDirectDeaths"/>   <!-- id 74 -->
            <option name="Vector_Sv"/> <!-- id 34 -->
            <option name="Vector_Nv"/> <!-- id 32 -->
            <!--option name="expectedSevere"/-->   <!-- id 77 -->

        </SurveyOptions>
        <surveys detectionLimit="40">
      <surveyTime>@start_year@-01-01</surveyTime>
      <surveyTime repeatStep="1y" repeatEnd="@end_year@-01-31">@start_year@-01-31</surveyTime>
      <surveyTime repeatStep="1y" repeatEnd="@end_year@-02-28">@start_year@-02-28</surveyTime>
      <surveyTime repeatStep="1y" repeatEnd="@end_year@-03-31">@start_year@-03-31</surveyTime>
      <surveyTime repeatStep="1y" repeatEnd="@end_year@-04-30">@start_year@-04-30</surveyTime>
      <surveyTime repeatStep="1y" repeatEnd="@end_year@-05-31">@start_year@-05-31</surveyTime>
      <surveyTime repeatStep="1y" repeatEnd="@end_year@-06-30">@start_year@-06-30</surveyTime>
      <surveyTime repeatStep="1y" repeatEnd="@end_year@-07-31">@start_year@-07-31</surveyTime>
      <surveyTime repeatStep="1y" repeatEnd="@end_year@-08-31">@start_year@-08-31</surveyTime>
      <surveyTime repeatStep="1y" repeatEnd="@end_year@-09-30">@start_year@-09-30</surveyTime>
      <surveyTime repeatStep="1y" repeatEnd="@end_year@-10-31">@start_year@-10-31</surveyTime>
      <surveyTime repeatStep="1y" repeatEnd="@end_year@-11-30">@start_year@-11-30</surveyTime>
      <surveyTime repeatStep="1y" repeatEnd="@end_year@-12-31">@start_year@-12-31</surveyTime>    
        </surveys>
        <ageGroup lowerbound="0">
        <group upperbound="5"/>
        <group upperbound="15"/>
        <group upperbound="100"/>
        </ageGroup>
    </monitoring>
    
    <!--INTERVENTION-->
    <interventions name="GVI example">
    <human>
      <component id="deterrency" name="itn">
      <GVI>
        <decay L="2.4" k="2.4" function="weibull"/>
        <anophelesParams mosquito="gambiaesl_indoor" propActive="1">
          <deterrency value="0.19"/>
          <preprandialKillingEffect value="0"/>
          <postprandialKillingEffect value="0"/>
        </anophelesParams>
        <anophelesParams mosquito="gambiaesl_outdoor" propActive="0">
        <deterrency value="0"/>
        <preprandialKillingEffect value="0.0"/>
        <postprandialKillingEffect value="0"/>
        </anophelesParams>
        </GVI>
        </component>
        <component id="martin_preprandial" name="your_tag">
        <GVI>
          <decay L="1.3" k="1.8" function="weibull"/>
          <anophelesParams mosquito="gambiaesl_indoor" propActive="1">
            <deterrency value="0"/>
            <preprandialKillingEffect value="0.41"/>
            <postprandialKillingEffect value="0"/>
          </anophelesParams>
          <anophelesParams mosquito="gambiaesl_outdoor" propActive="0">
        <deterrency value="0"/>
        <preprandialKillingEffect value="0.0"/>
        <postprandialKillingEffect value="0"/>
        </anophelesParams>
        </GVI>
      </component>
      <component id="martin_postprandial" name="your_tag">
        <GVI>
          <decay L="1.8" k="1.9" function="weibull"/>
          <anophelesParams mosquito="gambiaesl_indoor" propActive="1">
            <deterrency value="0"/>
            <preprandialKillingEffect value="0"/>
            <postprandialKillingEffect value="0.42"/>
          </anophelesParams>
          <anophelesParams mosquito="gambiaesl_outdoor" propActive="0">
        <deterrency value="0"/>
        <preprandialKillingEffect value="0.0"/>
        <postprandialKillingEffect value="0"/>
        </anophelesParams>
        </GVI>
      </component>
      <deployment name="itn">
        <component id="deterrency"/>
        <component id="martin_preprandial"/>
        <component id="martin_postprandial"/>
        <timed>
          <deploy coverage="@coverage@" time="2024-01-01"/>
          <deploy coverage="@coverage@"  time="2027-01-01"/>
          <deploy coverage="@coverage@"  time="2030-01-01"/>
        </timed>
      </deployment>
      <deployment name="itn">
         <component id="deterrency"/>
        <component id="martin_preprandial"/>
        <component id="martin_postprandial"/>
      <continuous>
      <deploy coverage="@coverage@" targetAgeYrs="0.5" begin="2024-01-01"/> 
        </continuous>
        </deployment>
    </human>
    </interventions>
    
    <!-- Specify health system parameters here, see: https://github.com/SwissTPH/openmalaria/wiki/ScenarioHealthSystem -->
    <healthSystem>
        <!-- The more flexible DecisionTree5Day replaces the older ImmediateOutcomes.
        The probabilities below are greatly affected by the presence (or the absence) of a clinic or hospital on site -->
        <DecisionTree5Day name="example name">
            <pSeekOfficialCareUncomplicated1 value="@access@"/><!-- 5-day probability that a patient uncomplicated case seeks official care -->
            <pSelfTreatUncomplicated value="0.0"/><!-- 5-day probability that a patient with uncomplicated case will self-treat -->
            <pSeekOfficialCareUncomplicated2 value="@access@"/><!-- 5-day probability that a patient with recurrence seeks official care -->
            <pSeekOfficialCareSevere value="0.48"/><!-- 5-day probability that a patient with severe case seeks official care -->
            <treeUCOfficial>
                <treatSimple durationLiver="0" durationBlood="1t"/>
            </treeUCOfficial>
            <treeUCSelfTreat>
                <noTreatment/>
            </treeUCSelfTreat>
            <cureRateSevere value="1.0"/>
            <treatmentSevere>
                <clearInfections stage="blood" timesteps="1t"/>
            </treatmentSevere>
        </DecisionTree5Day>
        <CFR>
            <group lowerbound="0" value="0.09189"/>
            <group lowerbound="0.25" value="0.0810811"/>
            <group lowerbound="0.75" value="0.0648649"/>
            <group lowerbound="1.5" value="0.0689189"/>
            <group lowerbound="2.5" value="0.0675676"/>
            <group lowerbound="3.5" value="0.0297297"/>
            <group lowerbound="4.5" value="0.0459459"/>
            <group lowerbound="7.5" value="0.0945946"/>
            <group lowerbound="12.5" value="0.1243243"/>
            <group lowerbound="15" value="0.1378378"/>
        </CFR>
        <pSequelaeInpatient interpolation="none">
            <group lowerbound="0.0" value="0.0132"/>
            <group lowerbound="5.0" value="0.005"/>
        </pSequelaeInpatient>
    </healthSystem>
    
     <entomology mode="dynamic" name="Tanzania" scaledAnnualEIR= "@preinterventionEIR@">
        <vector>
        <anopheles mosquito="gambiaesl_indoor" propInfected="0.078" propInfectious="0.021">
        <seasonality annualEIR="0.9" input="EIR">
                          <monthlyValues smoothing="fourier">
            <value>3</value>
            <value>3.5</value>
            <value>2</value>
            <value>13</value>
            <value>4.5</value>
            <value>6.5</value>
            <value>1</value>
            <value>0.5</value>
            <value>0.2</value>
            <value>0</value>
            <value>0</value>
            <value>0.1</value>
          </monthlyValues>
        </seasonality>
        <mosq minInfectedThreshold="0.001">
          <mosqRestDuration value="3"/>
          <extrinsicIncubationPeriod value="11"/>
          <mosqLaidEggsSameDayProportion value="0.313"/>
          <mosqSeekingDuration value="0.33"/>
          <mosqSurvivalFeedingCycleProbability value="0.623"/>
          <availability/>
          <mosqProbBiting mean="0.95" variance="0"/>
          <mosqProbFindRestSite mean="0.95" variance="0"/>
          <mosqProbResting mean="0.99" variance="0"/>
          <mosqProbOvipositing value="0.88"/>
          <mosqHumanBloodIndex value="0.939"/>
        </mosq>
        <nonHumanHosts name="unprotectedAnimals">
          <mosqRelativeEntoAvailability value="1.0"/>
          <mosqProbBiting value="0.95"/>
          <mosqProbFindRestSite value="0.95"/>
          <mosqProbResting value="0.99"/>
        </nonHumanHosts>
      </anopheles>
      <anopheles mosquito="gambiaesl_outdoor" propInfected="0.078" propInfectious="0.021">
        <seasonality annualEIR="0.1" input="EIR">
          <monthlyValues smoothing="fourier">
            <value>3</value>
            <value>3.5</value>
            <value>2</value>
            <value>13</value>
            <value>4.5</value>
            <value>6.5</value>
            <value>1</value>
            <value>0.5</value>
            <value>0.2</value>
            <value>0</value>
            <value>0</value>
            <value>0.1</value>
          </monthlyValues>
        </seasonality>
        <mosq minInfectedThreshold="0.001">
          <mosqRestDuration value="3"/>
          <extrinsicIncubationPeriod value="11"/>
          <mosqLaidEggsSameDayProportion value="0.313"/>
          <mosqSeekingDuration value="0.33"/>
          <mosqSurvivalFeedingCycleProbability value="0.623"/>
          <availability/>
          <mosqProbBiting mean="0.95" variance="0"/>
          <mosqProbFindRestSite mean="0.95" variance="0"/>
          <mosqProbResting mean="0.99" variance="0"/>
          <mosqProbOvipositing value="0.88"/>
          <mosqHumanBloodIndex value="0.939"/>
        </mosq>
        <nonHumanHosts name="unprotectedAnimals">
          <mosqRelativeEntoAvailability value="1.0"/>
          <mosqProbBiting value="0.95"/>
          <mosqProbFindRestSite value="0.95"/>
          <mosqProbResting value="0.99"/>
        </nonHumanHosts>
      </anopheles>
      </vector>
    </entomology>

    
    <diagnostics>
        <diagnostic name="Deterministic_diagnostic">
            <deterministic minDensity="40"/>
        </diagnostic>
    </diagnostics>
